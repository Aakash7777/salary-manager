{
  "name": "@salary-manager/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "seed": "nest build && node dist/seed/seed-cli.js",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:unit": "vitest run --exclude \"**/*.int.spec.ts\"",
    "test:int": "vitest run .int.spec --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/platform-express": "^12.5.1",
    "@salary-manager/shared": "*",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-dist": "^5.35.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.2"
  }
}
